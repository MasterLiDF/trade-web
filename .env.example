# ============================================
# 环境变量配置示例
# ============================================
# 复制此文件为 .env.local 后填入实际值

# MongoDB 连接字符串
# 本地开发：mongodb://localhost:27017/数据库名
# 生产环境（MongoDB Atlas）：mongodb+srv://用户名:密码@集群地址/数据库名?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/trade-web

# 应用端口（可选，默认3000）
PORT=3000

# JWT 密钥（用于登录 token 签名，至少32位随机字符串）
JWT_SECRET=your-secret-key-here
