# ============================================
# 本地开发环境配置
# ============================================

# MongoDB 连接字符串
# 本地使用默认端口，数据库名：trade-web
MONGODB_URI=mongodb://localhost:27017/trade-web

# 应用端口
PORT=3000

# JWT 密钥（用于登录后的 token 签名）
# 本地开发可以随意设置，生产环境必须使用强随机字符串
JWT_SECRET=asdfz123adzadfa12zouj
